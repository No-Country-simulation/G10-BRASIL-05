# Endereço da API do MediFlow, por exemplo http://localhost:8000
# Vazio: modo demonstração, com dados fictícios e sem conexão com a API
API_BASE_URL=
# Tempo máximo de espera pela API, em segundos
API_TIMEOUT=60
# MODO_DEMONSTRACAO=true liga o mock. Sem a variável, o front usa a API real
MODO_DEMONSTRACAO=