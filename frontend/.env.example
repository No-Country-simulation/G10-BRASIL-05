# Ambiente: local ou production
APP_ENV=local
# URL utilizada apenas quando APP_ENV=local
API_URL_LOCAL=http://localhost:8000
# Preencha quando a URL de produção estiver definida; production nunca cai para local
API_URL_PRODUCTION=
# Tempo máximo de espera pela API, em segundos
API_TIMEOUT=60
# Ative somente para demonstração local. Produção bloqueia este modo.
MODO_DEMONSTRACAO=false
