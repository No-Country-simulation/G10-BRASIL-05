# Endereço da API do MediFlow. Se ficar vazio, usa http://localhost:8000
API_BASE_URL=
# Tempo máximo de espera pela API, em segundos
API_TIMEOUT=60
# Coloque true para usar dados fictícios, sem conexão com a API.
# Deixe vazio no uso real: com a API fora do ar, o front mostra o erro e não simula nada.
MODO_DEMONSTRACAO=
