// MediFlow — esquema PostgreSQL V4 implementado no backend e na migration-base Alembic.
// Gerado a partir de backend/app/models/triagem.py; constraints/índices parciais anotados abaixo.
Project mediflow_postgresql {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL guarda relações e estado operacional. MongoDB guarda payloads clínicos/auditoria via outbox. A Evolution usa banco separado.'
}

Table categorias_hospital {
  id integer [pk]
  nome varchar(80) [not null, unique]
  descricao varchar(250)

  indexes {
    (nome) [unique]
  }
}

Table cidades {
  id integer [pk]
  nome varchar(100) [not null]
  uf varchar(2) [not null]

  indexes {
    (nome, uf) [unique, name: 'uq_cidades_nome_uf']
  }
}

Table contatos_whatsapp {
  id integer [pk]
  numero varchar(30) [not null, unique]
  nome varchar(150)

  indexes {
    (numero) [unique]
  }
}

Table enfermeiros {
  id integer [pk]
  coren varchar(30) [not null]
  uf varchar(2) [not null]
  nome varchar(150) [not null]
  area_atuacao varchar(100)
  created_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (coren, uf) [unique, name: 'uq_enfermeiros_coren_uf']
  }
}

Table especialidades {
  id integer [pk]
  nome varchar(100) [not null, unique]

  indexes {
    (nome) [unique]
  }
}

Table medicos {
  id integer [pk]
  crm varchar(30) [not null]
  uf varchar(2) [not null]
  nome varchar(150) [not null]
  created_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (crm, uf) [unique, name: 'uq_medicos_crm_uf']
  }
}

Table pacientes {
  id integer [pk]
  cpf varchar(20) [unique]
  nome varchar(150) [not null]
  data_nascimento date
  cadastro_provisorio boolean [not null, default: false]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (cpf) [unique]
  }
}

Table estabelecimentos_saude {
  id integer [pk]
  tipo varchar(20) [not null]
  nome varchar(180) [not null]
  cnpj varchar(30) [unique]
  logradouro varchar(180)
  numero varchar(30)
  complemento varchar(120)
  bairro varchar(100)
  cep varchar(12)
  cidade_id integer [not null]
  ativo boolean [not null, default: true]
  created_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (cnpj) [unique]
    (cidade_id) [name: 'ix_estabelecimentos_saude_cidade_id']
  }

  Note: 'CHECK: tipo IN (\'HOSPITAL\', \'CLINICA\')'
}

Table medico_especialidades {
  medico_id integer [pk]
  especialidade_id integer [pk]
}

Table usuarios_sistema {
  id integer [pk]
  email varchar(150) [not null, unique]
  nome varchar(150) [not null]
  senha_hash varchar(255) [not null]
  papel varchar(50) [not null, default: `SOMENTE_LEITURA`]
  registro varchar(80)
  especialidade varchar(150)
  trocar_senha_obrigatorio boolean [not null, default: false]
  medico_id integer
  enfermeiro_id integer
  pode_gerenciar_whatsapp boolean [not null, default: false]
  ativo boolean [not null, default: true]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (email) [unique]
  }
}

Table atendimentos {
  id integer [pk]
  paciente_id integer [not null]
  estabelecimento_id integer [not null]
  data_atendimento timestamp with time zone [not null, default: `now()`]
  status varchar(30) [not null, default: `ABERTO`]

  indexes {
    (id, paciente_id) [unique, name: 'uq_atendimentos_id_paciente']
    (id, estabelecimento_id) [unique, name: 'uq_atendimentos_id_estabelecimento']
    (paciente_id) [name: 'ix_atendimentos_paciente_id']
    (estabelecimento_id) [name: 'ix_atendimentos_estabelecimento_id']
  }
}

Table clinicas {
  estabelecimento_id integer [pk]
}

Table destinos_roteamento {
  id integer [pk]
  codigo varchar(50) [not null, unique]
  tipo varchar(25) [not null]
  estabelecimento_id integer
  descricao varchar(250)

  indexes {
    (codigo) [unique]
  }

  Note: 'CHECK: tipo IN (\'FILA\', \'ESTABELECIMENTO\'); (tipo = \'ESTABELECIMENTO\') = (estabelecimento_id IS NOT NULL)'
}

Table estabelecimento_enfermeiros {
  estabelecimento_id integer [pk]
  enfermeiro_id integer [pk]
  inicio_vinculo timestamp with time zone [pk, default: `now()`]
  fim_vinculo timestamp with time zone
  funcao varchar(50)
}

Table estabelecimento_profissionais {
  estabelecimento_id integer [pk]
  medico_id integer [pk]
  inicio_vinculo timestamp with time zone [pk, default: `now()`]
  fim_vinculo timestamp with time zone
  funcao varchar(50)
}

Table hospitais {
  estabelecimento_id integer [pk]
  categoria_id integer
}

Table instancias_whatsapp {
  id integer [pk]
  instance_name varchar(100) [not null, unique]
  status_conexao varchar(50) [not null, default: `close`]
  numero_conectado varchar(30)
  webhook_url varchar(500)
  gerenciado_por_usuario_id integer
  gerenciado_por_email_configurado varchar(150)
  modo_operacao varchar(50) [not null, default: `AGENTE_AUTONOMO_UNICO`]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (instance_name) [unique]
  }
}

Table atendimento_enfermeiros {
  atendimento_id integer [pk]
  enfermeiro_id integer [pk]
  funcao varchar(50)
}

Table atendimento_profissionais {
  atendimento_id integer [pk]
  medico_id integer [pk]
  funcao varchar(50)
}

Table documentos_triagem {
  id integer [pk]
  documento_externo_id varchar(100) [not null, unique]
  tipo_arquivo varchar(50) [not null]
  canal_origem varchar(100)
  paciente_id integer
  medico_id integer
  estabelecimento_id integer
  atendimento_id integer
  tipo_documento varchar(100)
  cid_principal varchar(10)
  nivel_prioridade varchar(50) [not null, default: `Indefinida`]
  score_confianca numeric(5, 4)
  destino_id integer
  status_processamento varchar(30) [not null, default: `RECEBIDO`]
  versao integer [not null, default: 0]
  ultima_sequencia integer [not null, default: 0]
  mongo_audit_stream_id uuid [not null, unique, default: `<function uuid4 at 0x73adc890c4a0>`]
  whatsapp_numero varchar(30)
  whatsapp_nome varchar(150)
  whatsapp_message_id varchar(150)
  hash_sha256 varchar(64)
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (documento_externo_id) [unique]
    (id, atendimento_id) [unique, name: 'uq_documentos_id_atendimento']
    (mongo_audit_stream_id) [unique]
    (destino_id) [name: 'ix_documentos_triagem_destino_id']
    (medico_id) [name: 'ix_documentos_triagem_medico_id']
    (atendimento_id) [name: 'ix_documentos_triagem_atendimento_id']
    (status_processamento, created_at) [name: 'ix_documentos_status_created']
    (whatsapp_message_id) [name: 'ix_documentos_triagem_whatsapp_message_id']
    (created_at) [name: 'ix_documentos_revisao_fila']
    (paciente_id) [name: 'ix_documentos_triagem_paciente_id']
    (estabelecimento_id) [name: 'ix_documentos_triagem_estabelecimento_id']
  }

  Note: 'CHECK: status_processamento IN (\'RECEBIDO\',\'EM_PROCESSAMENTO\',\'PENDENTE_IDENTIFICACAO\',\'EM_REVISAO_HUMANA\',\'ROTEADO\',\'CONCLUIDO\',\'REJEITADO\',\'ERRO\',\'AGUARDANDO_REENVIO\'); status_processamento NOT IN (\'ROTEADO\',\'CONCLUIDO\') OR destino_id IS NOT NULL; score_confianca IS NULL OR score_confianca BETWEEN 0 AND 1; status_processamento <> \'CONCLUIDO\' OR (paciente_id IS NOT NULL AND estabelecimento_id IS NOT NULL); atendimento_id IS NULL OR (paciente_id IS NOT NULL AND estabelecimento_id IS NOT NULL)'
}

Table hospital_diretores {
  hospital_id integer [pk]
  usuario_id integer [pk]
  inicio_vinculo timestamp with time zone [pk, default: `now()`]
  fim_vinculo timestamp with time zone
}

Table auditoria_outbox {
  evento_id uuid [pk]
  documento_id integer [not null]
  documento_externo_id varchar(100) [not null]
  sequencia integer [not null]
  tipo_evento varchar(60) [not null]
  ocorrido_em timestamp with time zone [not null, default: `now()`]
  payload jsonb [not null]
  payload_hash varchar(64) [not null]
  status varchar(20) [not null, default: `PENDENTE`]
  tentativas integer [not null, default: 0]
  claim_token uuid
  lease_ate timestamp with time zone
  proxima_tentativa_em timestamp with time zone
  erro_ultimo text
  mongo_evento_id varchar(100)
  criado_em timestamp with time zone [not null, default: `now()`]
  publicado_em timestamp with time zone

  indexes {
    (documento_id, sequencia) [unique, name: 'uq_outbox_documento_sequencia']
    (criado_em) [name: 'ix_outbox_pendente']
    (documento_id, sequencia) [name: 'ix_outbox_stream_sequencia']
  }

  Note: 'CHECK: tentativas >= 0; status IN (\'PENDENTE\',\'EM_PUBLICACAO\',\'PUBLICADO\',\'ERRO\',\'ERRO_INTEGRIDADE\'); sequencia > 0'
}

Table documento_arquivos {
  id integer [pk]
  documento_id integer [not null]
  papel varchar(20) [not null]
  bucket varchar(150) [not null]
  caminho_atual varchar(500) [not null]
  hash_sha256 varchar(64)
  created_at timestamp with time zone [not null, default: `now()`]

  indexes {
    (bucket, caminho_atual) [unique, name: 'uq_documento_arquivo_objeto']
    (documento_id) [name: 'ix_documento_arquivos_documento_id']
    (hash_sha256) [name: 'ix_documento_arquivos_hash_sha256']
  }
}

Table documento_especialidades {
  documento_id integer [pk]
  especialidade_id integer [pk]
}

Table documento_origem_whatsapp {
  documento_id integer [pk]
  contato_id integer [not null]
  instancia_id integer [not null]
  message_id varchar(150) [not null]

  indexes {
    (instancia_id, message_id) [unique, name: 'uq_whatsapp_instancia_mensagem']
    (contato_id) [name: 'ix_documento_origem_whatsapp_contato_id']
  }
}

Table encaminhamentos {
  id integer [pk]
  atendimento_id integer [not null]
  documento_id integer [not null]
  destino_id integer [not null]
  status varchar(25) [not null, default: `SOLICITADO`]
  solicitado_em timestamp with time zone [not null, default: `now()`]
  concluido_em timestamp with time zone
  usuario_responsavel_id integer
  observacao text

  indexes {
    (atendimento_id) [name: 'ix_encaminhamentos_atendimento_id']
    (documento_id, atendimento_id) [name: 'ix_encaminhamentos_documento_atendimento']
    (destino_id, status) [name: 'ix_encaminhamentos_destino_status']
  }

  Note: 'CHECK: status IN (\'SOLICITADO\',\'ACEITO\',\'CONCLUIDO\',\'RECUSADO\',\'CANCELADO\')'
}

Table revisoes {
  id integer [pk]
  documento_id integer [not null]
  revisor_id integer [not null]
  decisao varchar(30) [not null]
  observacao text
  revisado_em timestamp with time zone [not null, default: `now()`]

  indexes {
    (documento_id) [name: 'ix_revisoes_documento_id']
    (revisor_id) [name: 'ix_revisoes_revisor_id']
  }
}

Table arquivo_movimentacoes {
  id integer [pk]
  arquivo_id integer [not null]
  bucket_origem varchar(150)
  caminho_origem varchar(500) [not null]
  bucket_destino varchar(150)
  caminho_destino varchar(500) [not null]
  motivo varchar(60)
  movido_em timestamp with time zone [not null, default: `now()`]
}

Ref: estabelecimentos_saude.cidade_id > cidades.id [delete: restrict, update: restrict]
Ref: medico_especialidades.especialidade_id > especialidades.id [delete: restrict, update: restrict]
Ref: medico_especialidades.medico_id > medicos.id [delete: restrict, update: restrict]
Ref: usuarios_sistema.medico_id > medicos.id [delete: restrict, update: restrict]
Ref: usuarios_sistema.enfermeiro_id > enfermeiros.id [delete: restrict, update: restrict]
Ref: atendimentos.paciente_id > pacientes.id [delete: restrict, update: restrict]
Ref: atendimentos.estabelecimento_id > estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: clinicas.estabelecimento_id - estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: destinos_roteamento.estabelecimento_id > estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: estabelecimento_enfermeiros.estabelecimento_id > estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: estabelecimento_enfermeiros.enfermeiro_id > enfermeiros.id [delete: restrict, update: restrict]
Ref: estabelecimento_profissionais.estabelecimento_id > estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: estabelecimento_profissionais.medico_id > medicos.id [delete: restrict, update: restrict]
Ref: hospitais.categoria_id > categorias_hospital.id [delete: restrict, update: restrict]
Ref: hospitais.estabelecimento_id - estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: instancias_whatsapp.gerenciado_por_usuario_id > usuarios_sistema.id [delete: restrict, update: restrict]
Ref: atendimento_enfermeiros.atendimento_id > atendimentos.id [delete: restrict, update: restrict]
Ref: atendimento_enfermeiros.enfermeiro_id > enfermeiros.id [delete: restrict, update: restrict]
Ref: atendimento_profissionais.medico_id > medicos.id [delete: restrict, update: restrict]
Ref: atendimento_profissionais.atendimento_id > atendimentos.id [delete: restrict, update: restrict]
Ref: documentos_triagem.medico_id > medicos.id [delete: restrict, update: restrict]
Ref: documentos_triagem.destino_id > destinos_roteamento.id [delete: restrict, update: restrict]
Ref: documentos_triagem.(atendimento_id, paciente_id) > atendimentos.(id, paciente_id) [delete: restrict, update: restrict]
Ref: documentos_triagem.paciente_id > pacientes.id [delete: restrict, update: restrict]
Ref: documentos_triagem.estabelecimento_id > estabelecimentos_saude.id [delete: restrict, update: restrict]
Ref: documentos_triagem.(atendimento_id, estabelecimento_id) > atendimentos.(id, estabelecimento_id) [delete: restrict, update: restrict]
Ref: hospital_diretores.hospital_id > hospitais.estabelecimento_id [delete: restrict, update: restrict]
Ref: hospital_diretores.usuario_id > usuarios_sistema.id [delete: restrict, update: restrict]
Ref: auditoria_outbox.documento_id > documentos_triagem.id [delete: restrict, update: restrict]
Ref: documento_arquivos.documento_id > documentos_triagem.id [delete: restrict, update: restrict]
Ref: documento_especialidades.especialidade_id > especialidades.id [delete: restrict, update: restrict]
Ref: documento_especialidades.documento_id > documentos_triagem.id [delete: restrict, update: restrict]
Ref: documento_origem_whatsapp.contato_id > contatos_whatsapp.id [delete: restrict, update: restrict]
Ref: documento_origem_whatsapp.documento_id - documentos_triagem.id [delete: restrict, update: restrict]
Ref: documento_origem_whatsapp.instancia_id > instancias_whatsapp.id [delete: restrict, update: restrict]
Ref: encaminhamentos.usuario_responsavel_id > usuarios_sistema.id [delete: restrict, update: restrict]
Ref: encaminhamentos.(documento_id, atendimento_id) > documentos_triagem.(id, atendimento_id) [delete: restrict, update: restrict]
Ref: encaminhamentos.atendimento_id > atendimentos.id [delete: restrict, update: restrict]
Ref: encaminhamentos.destino_id > destinos_roteamento.id [delete: restrict, update: restrict]
Ref: revisoes.revisor_id > usuarios_sistema.id [delete: restrict, update: restrict]
Ref: revisoes.documento_id > documentos_triagem.id [delete: restrict, update: restrict]
Ref: arquivo_movimentacoes.arquivo_id > documento_arquivos.id [delete: restrict, update: restrict]

// Exceções DBML: índices parciais, defaults gerados e exclusão btree_gist são implementados/planejados em SQL, não integralmente expressos aqui.
// CHECKs aparecem nas notas das tabelas. O histórico Mongo usa documento_id externo + sequencia e evento_id único parcial.
// data_nascimento permanece opcional; idade informada no documento fica no evento clínico do Mongo.
