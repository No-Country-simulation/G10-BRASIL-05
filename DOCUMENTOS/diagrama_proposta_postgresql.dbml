// MediFlow — proposta histórica de esquema relacional PostgreSQL.
// SUBSTITUÍDA por DOCUMENTOS/diagrama_postgresql.dbml, que representa o modelo V4 implementado.
// Mantida apenas para referência das decisões que antecederam a migration-base.

Project mediflow_postgresql_proposta {
  database_type: 'PostgreSQL'
  Note: 'PROPOSTA. PostgreSQL mantém relações e estado operacional atual. MongoDB recebe eventos/snapshots de auditoria. Evolution e tabelas internas do checkpointer LangGraph fora do escopo.'
}

Table hospitais {
  estabelecimento_id integer [pk, note: 'PK e FK para estabelecimentos_saude; subtipo HOSPITAL.']
  categoria_id integer
}

Table medicos {
  id integer [pk, increment]
  crm varchar(30) [not null]
  nome varchar(150) [not null]
  uf varchar(2) [not null]
  especialidade varchar(100)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (crm, uf) [unique, name: 'uq_medicos_crm_uf']
  }
}

Table pacientes {
  id integer [pk, increment]
  cpf varchar(20) [unique]
  nome varchar(150) [not null]
  data_nascimento date
  cadastro_provisorio boolean [default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado pela aplicação ou trigger.']
}

Table documentos_triagem {
  id integer [pk, increment]
  documento_id varchar(100) [not null, unique]
  tipo_arquivo varchar(50) [not null]
  canal_origem varchar(100) [default: 'Pronto_Socorro']
  paciente_id integer
  medico_id integer
  hospital_estabelecimento_id integer
  atendimento_id integer
  tipo_documento varchar(100)
  especialidade varchar(100)
  nivel_prioridade varchar(50) [not null, default: 'Indefinida', note: 'CHECK: Indefinida, Rotina, Urgente ou Emergência. Indefinida exige revisão.']
  score_confianca float [note: 'NULL quando não calculada; nunca assumir confiança máxima.']
  destino_id integer
  requer_auditoria_humana boolean [not null, default: true]
  status_processamento varchar(50) [not null, default: 'recebido', note: 'CHECK com estados válidos do fluxo.']
  justificativa_roteamento text
  escopo_documento varchar(30) [note: 'CHECK com valores definidos no contrato do pipeline.']
  legibilidade_documento varchar(30) [note: 'CHECK com valores definidos no contrato do pipeline.']
  justificativa_escopo text
  motivo_revisao text
  etapa_revisao varchar(50) [note: 'CHECK com etapas válidas da revisão humana.']
  revisor_id integer
  revisado_em timestamptz
  decisao_revisao varchar(40) [note: 'CHECK: APROVADO, CORRIGIDO ou REJEITADO.']
  caminho_fonte varchar(500)
  bucket_oci varchar(150)
  caminho_objeto_oci varchar(255)
  mongo_audit_stream_id uuid [not null, unique, note: 'Referência lógica para buscar eventos e snapshots no Mongo; não é FK relacional.']
  whatsapp_numero varchar(30)
  whatsapp_nome varchar(150)
  whatsapp_message_id varchar(150)
  hash_sha256 varchar(64) [note: 'Hash do arquivo original para integridade e deduplicação.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado pela aplicação ou trigger.']

  indexes {
    (paciente_id)
    (medico_id)
    (hospital_estabelecimento_id)
    (status_processamento, requer_auditoria_humana, created_at) [name: 'ix_documentos_triagem_fila']
    (whatsapp_message_id) [unique, name: 'uq_documentos_whatsapp_message_id']
  }
}

Table auditoria_outbox {
  evento_id uuid [pk, note: 'ID idempotente compartilhado com o evento publicado no Mongo.']
  documento_id varchar(100) [not null]
  mongo_audit_stream_id uuid [not null]
  tipo_evento varchar(60) [not null]
  payload jsonb [not null, note: 'JSON clínico pendente de publicação. Após confirmação no Mongo, remover o payload conforme política de retenção.']
  status varchar(20) [not null, default: 'PENDENTE']
  tentativas integer [not null, default: 0]
  erro_ultimo text
  criado_em timestamptz [not null, default: `now()`]
  publicado_em timestamptz
  mongo_evento_id varchar(100) [note: 'ID retornado pelo MongoDB após publicação.']

  indexes {
    (criado_em) [note: 'Na migration, preferir índice parcial WHERE status = PENDENTE. Worker usa FOR UPDATE SKIP LOCKED.']
    (documento_id, criado_em)
  }
}

Table usuarios_sistema {
  id integer [pk, increment]
  email varchar(150) [not null, unique]
  nome varchar(150) [not null]
  senha_hash varchar(255) [not null]
  papel varchar(50) [not null, note: 'CHECK com papéis permitidos; definir explicitamente no cadastro, sem default privilegiado.']
  trocar_senha_obrigatorio boolean [not null, default: false]
  registro varchar(100)
  especialidade varchar(150)
  pode_gerenciar_whatsapp boolean [not null, default: false]
  ativo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado pela aplicação ou trigger.']
}

Table instancias_whatsapp {
  id integer [pk, increment]
  instance_name varchar(100) [not null, unique]
  status_conexao varchar(50) [not null, default: 'close']
  conectado boolean [not null, default: false]
  numero_conectado varchar(30)
  webhook_url varchar(500)
  gerenciado_por_usuario_id integer [not null]
  modo_operacao varchar(50) [not null, default: 'AGENTE_AUTONOMO_UNICO']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado pela aplicação ou trigger.']
}

Table enfermeiros {
  id integer [pk, increment]
  coren varchar(30) [not null]
  nome varchar(150) [not null]
  area_atuacao varchar(100)
  uf varchar(2) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (coren, uf) [unique, name: 'uq_enfermeiros_coren_uf']
  }
}

Table estabelecimentos_saude {
  id integer [pk, increment]
  tipo varchar(20) [not null, note: 'CHECK: HOSPITAL ou CLINICA']
  nome varchar(180) [not null]
  cnpj varchar(30) [unique]
  logradouro varchar(180)
  numero varchar(30)
  complemento varchar(120)
  bairro varchar(100)
  cidade varchar(100) [not null]
  uf varchar(2) [not null]
  cep varchar(12)
  ativo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table categorias_hospital {
  id integer [pk, increment]
  nome varchar(80) [not null, unique]
  descricao varchar(250)
}

Table clinicas {
  estabelecimento_id integer [pk]
}

Table estabelecimento_profissionais {
  vinculo_id integer [pk, increment]
  estabelecimento_id integer [not null]
  medico_id integer [not null]
  funcao varchar(50)
  ativo boolean [not null, default: true]
  inicio_vinculo timestamptz [not null, default: `now()`]
  fim_vinculo timestamptz

  indexes {
    (estabelecimento_id, medico_id, inicio_vinculo) [unique]
  }
}

Table estabelecimento_enfermeiros {
  vinculo_id integer [pk, increment]
  estabelecimento_id integer [not null]
  enfermeiro_id integer [not null]
  funcao varchar(50)
  ativo boolean [not null, default: true]
  inicio_vinculo timestamptz [not null, default: `now()`]
  fim_vinculo timestamptz

  indexes {
    (estabelecimento_id, enfermeiro_id, inicio_vinculo) [unique]
  }
}

Table hospital_diretores {
  vinculo_id integer [pk, increment]
  hospital_estabelecimento_id integer [not null]
  usuario_id integer [not null]
  inicio_vinculo timestamptz [not null, default: `now()`]
  fim_vinculo timestamptz

  indexes {
    (hospital_estabelecimento_id, usuario_id, inicio_vinculo) [unique]
  }
}

Table atendimentos {
  id integer [pk, increment]
  paciente_id integer [not null]
  estabelecimento_id integer
  data_atendimento timestamptz [not null, default: `now()`]
  status varchar(30) [not null, default: 'ABERTO']
}

Table atendimento_profissionais {
  atendimento_id integer [not null]
  medico_id integer [not null]
  funcao varchar(50)

  indexes {
    (atendimento_id, medico_id) [pk]
  }
}

Table atendimento_enfermeiros {
  atendimento_id integer [not null]
  enfermeiro_id integer [not null]
  funcao varchar(50)

  indexes {
    (atendimento_id, enfermeiro_id) [pk]
  }
}

Table destinos_roteamento {
  id integer [pk, increment]
  codigo varchar(50) [not null, unique]
  tipo varchar(25) [not null, note: 'CHECK: FILA ou ESTABELECIMENTO']
  estabelecimento_id integer
  descricao varchar(250)
}

Table encaminhamentos {
  id integer [pk, increment]
  atendimento_id integer [not null]
  destino_id integer [not null]
  documento_id varchar(100) [note: 'Documento que originou este encaminhamento, quando aplicável.']
  status varchar(25) [not null, default: 'SOLICITADO', note: 'CHECK: SOLICITADO, ACEITO, CONCLUIDO, RECUSADO ou CANCELADO']
  solicitado_em timestamptz [not null, default: `now()`]
  concluido_em timestamptz
  usuario_responsavel_id integer
  observacao text
}

Ref: documentos_triagem.paciente_id > pacientes.id
Ref: documentos_triagem.medico_id > medicos.id
Ref: documentos_triagem.hospital_estabelecimento_id > hospitais.estabelecimento_id
Ref: documentos_triagem.atendimento_id > atendimentos.id
Ref: documentos_triagem.destino_id > destinos_roteamento.id

Ref: hospitais.estabelecimento_id - estabelecimentos_saude.id
Ref: hospitais.categoria_id > categorias_hospital.id
Ref: clinicas.estabelecimento_id > estabelecimentos_saude.id
Ref: estabelecimento_profissionais.estabelecimento_id > estabelecimentos_saude.id
Ref: estabelecimento_profissionais.medico_id > medicos.id
Ref: estabelecimento_enfermeiros.estabelecimento_id > estabelecimentos_saude.id
Ref: estabelecimento_enfermeiros.enfermeiro_id > enfermeiros.id
Ref: hospital_diretores.hospital_estabelecimento_id > hospitais.estabelecimento_id
Ref: hospital_diretores.usuario_id > usuarios_sistema.id

Ref: atendimentos.paciente_id > pacientes.id
Ref: atendimentos.estabelecimento_id > estabelecimentos_saude.id
Ref: atendimento_profissionais.atendimento_id > atendimentos.id
Ref: atendimento_profissionais.medico_id > medicos.id
Ref: atendimento_enfermeiros.atendimento_id > atendimentos.id
Ref: atendimento_enfermeiros.enfermeiro_id > enfermeiros.id
Ref: destinos_roteamento.estabelecimento_id > estabelecimentos_saude.id
Ref: encaminhamentos.atendimento_id > atendimentos.id
Ref: encaminhamentos.destino_id > destinos_roteamento.id
Ref: encaminhamentos.documento_id > documentos_triagem.documento_id
Ref: encaminhamentos.usuario_responsavel_id > usuarios_sistema.id
Ref: documentos_triagem.revisor_id > usuarios_sistema.id
Ref: instancias_whatsapp.gerenciado_por_usuario_id > usuarios_sistema.id

Ref: auditoria_outbox.documento_id > documentos_triagem.documento_id

// mongo_audit_stream_id é uma referência lógica entre bancos; não pode ser FK no PostgreSQL.
// O JSON clínico detalhado e os snapshots de auditoria ficam na coleção Mongo proposta.
// Hospital preserva o padrão subtipo/PK=FK de clinicas; os dados comuns ficam em estabelecimentos_saude.
// Outbox deve ser gravada na mesma transação PostgreSQL da alteração operacional.
// CPF/nome são dados pessoais: produção deve definir criptografia, controle de acesso, retenção e busca compatíveis com LGPD.
// Na migration, criar o índice do WhatsApp como parcial: WHERE whatsapp_message_id IS NOT NULL.
