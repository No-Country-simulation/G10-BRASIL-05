# Configuração exclusiva da aplicação backend (FastAPI)
APP_NAME=MediFlow API
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Autenticação JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Conta criada apenas na inicialização, se ainda não houver ADMIN_GERAL
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador Geral

# Evolution API/WhatsApp (no Compose, essas URLs são sobrescritas para os serviços Docker)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=mediflow
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=http://localhost:8000/webhook/evolution
