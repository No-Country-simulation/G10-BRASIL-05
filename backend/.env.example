# ==============================================================================
# MediFlow Backend - Variáveis de Ambiente (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME=MediFlow API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# ------------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediflow_db

# ------------------------------------------------------------------------------
# 3. Modelos de IA e LLM (LangGraph / Triagem Clínica)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GOOGLE_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# 4. Oracle Cloud Infrastructure (OCI Object Storage Always Free)
# ------------------------------------------------------------------------------
OCI_USER_OCID=ocid1.user.oc1..
OCI_TENANCY_OCID=ocid1.tenancy.oc1..
OCI_FINGERPRINT=xx:xx:xx:xx...
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=sa-saopaulo-1
OCI_NAMESPACE=seu_namespace_aqui
OCI_BUCKET_NAME=mediflow-documentos-clinicos
