# ==============================================================================
# G10-BRASIL-05 - Variáveis de Ambiente de Exemplo (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas configurações locais:
#   cp .env.example .env
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Jira / Atlassian (Integração MCP & Gestão de Tarefas)
# ------------------------------------------------------------------------------
JIRA_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=
# ------------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=g10_brasil_db
DB_USER=postgres
DB_PASSWORD=postgres_password_aqui
DB_SSL_MODE=disable

# String de Conexão (Opcional / Gerada a partir dos dados acima)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_ASYNC_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 3. Configurações da Aplicação (FastAPI / Backend)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=gere_uma_chave_secreta_segura_aqui

# ------------------------------------------------------------------------------
# 4. Modelos de IA e LLM (LangGraph / Triagem Clínica)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. Oracle Cloud Infrastructure (OCI Object Storage)
# ------------------------------------------------------------------------------
OCI_USER_OCID=ocid1.user.oc1..
OCI_TENANCY_OCID=ocid1.tenancy.oc1..
OCI_FINGERPRINT=xx:xx:xx:xx...
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=sa-saopaulo-1
OCI_NAMESPACE=seu_namespace_aqui
OCI_BUCKET_NAME=g10-documentos-clinicos
