# Infraestrutura compartilhada: bancos, LLM, OCI, Evolution e portas do Compose.
COMPOSE_PROFILES=infra
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
DB_NAME=mediflow_db
DB_PORT=5432
REDIS_PORT=6379
MONGO_DB=mediflow_auditoria
MONGO_PORT=27017
EVOLUTION_DB_NAME=evolution
BACKEND_PORT=8000
FRONTEND_PORT=8501
TRIAGEM_WORKER_CONCURRENCY=5
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080

# URLs usadas pelo backend (localmente e no Compose sobrescrevemos para os nomes dos serviços).
DATABASE_URL=postgresql://postgres:troque_esta_senha@localhost:5432/mediflow_db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=mediflow_auditoria
MONGODB_ENABLED=true

# LLM
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CONFIDENCE_THRESHOLD=0.80

# OCI Object Storage
OCI_AUTH_MODE=api_key
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=
OCI_BUCKET_NAME=mediflow-documentos-clinicos

# Evolution API. O profile `infra` inclui o serviço `whatsapp` no Compose.
# Gere EVOLUTION_API_KEY e EVOLUTION_WEBHOOK_SECRET com valores aleatórios distintos;
# EVOLUTION_WEBHOOK_SECRET precisa ter pelo menos 32 caracteres.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=mediflow
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=http://backend:8000/webhook/evolution
